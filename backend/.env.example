# CapIAbara backend environment variables
# Copy this file to .env and fill in the values.

# Application
APP_NAME=CapIAbara API
DEBUG=false

# Database
DATABASE_URL=sqlite:///./capiabara.db

# Google OAuth — obtain from Google Cloud Console (REQUIRED)
GOOGLE_CLIENT_ID=

# App-issued JWT — generate a strong random secret for production (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=capiabara
JWT_AUDIENCE=capiabara
JWT_EXPIRATION_DAYS=30

# CORS — comma-separated list of allowed frontend origins; never use * in production
CORS_ORIGINS=http://localhost:5173
